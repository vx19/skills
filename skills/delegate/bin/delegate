#!/usr/bin/env python3
"""delegate entry point. Symlink-safe."""
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parents[1]  # follows symlinks
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from delegate.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
